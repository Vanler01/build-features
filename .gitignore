.DS_Store
__pycache__/
*.pyc
*.pyo
en-th-word-swap/cache/
num-to-text/cache/
morse-code/cache/
old_ver/

# AI projects — secrets and build artifacts (never commit)
.env
.env.local
.env.production
*/.env
*/.env.local
*/.env.production
node_modules/
dist/
*.sqlite
*.sqlite3
# WAL mode writes sidecar files next to the database; the glob above misses
# them because the suffix comes after the extension.
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/

.claude/*
!.claude/settings.json
!.claude/agents/
.claude/settings.local.json
compass_artifact_*.md

# Flutter — unanchored so they match at any depth (the app lives in
# hydration-drink-ai/app/, not at the repo root)
.dart_tool/
**/app/build/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Android / Gradle build output (the SDK path is machine-specific)
**/android/.gradle/
**/android/app/build/
**/android/local.properties
*.apk

# TypeScript build output
**/dist/
