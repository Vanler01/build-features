# Copy to .env and fill in real values. Never commit .env — it's git-ignored.

# @BotFather → /newbot → the token it gives you
TELEGRAM_BOT_TOKEN=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Where the store lives. Defaults to data/store.sqlite3 when unset.
DB_PATH=

# Port for the local backend the browser extension talks to (default 8787).
# It binds to 127.0.0.1 only. If you change this, change API in
# extension/src/result.ts to match and rebuild the extension.
SLANG_API_PORT=

# Claude calls allowed per UTC day, across the bot and the extension backend.
# Defaults to 200 when unset. Set to "none" for no ceiling — that has to be
# typed, so a missing value can never quietly mean unlimited. Past the limit
# the store still answers; only new lookups stop.
SLANG_DAILY_CALL_LIMIT=

# Your name, recorded as verified_by when you promote an entry.
# Optional — `npm run review -- verify <term> --by <you>` works instead.
SLANG_REVIEWER=
