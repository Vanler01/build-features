# Copy to .env and fill in. NEVER commit .env — see ../AI_PROJECTS.md.
# If a value here is ever filled in with a real secret, that secret is burned:
# rotate it, don't just delete the line.

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram -------------------------------------------------------------
# From @BotFather. Format looks like 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# --- LINE -----------------------------------------------------------------
# LINE Developers console → Messaging API channel.
# Free plan (Thailand) is 300 PUSH messages/month. Reply messages are free.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Google Places (Phase 6) ----------------------------------------------
# Restrict this key to the Places API in the Cloud console.
GOOGLE_PLACES_API_KEY=

# --- USDA FoodData Central (catalog sourcing only) ------------------------
# Free key from https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=

# --- App ------------------------------------------------------------------
HYDRATION_DB_PATH=./hydration.sqlite3
# Base URL used to build the bot -> app deep link.
HYDRATION_LINK_BASE_URL=https://link.example.com
